{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:phase1": "node supabase/tests/phase1-access.mjs",
    "test:fixture-access": "node tests/100-fixture-access.mjs",
    "test:entry": "tsx --test tests/entry.test.ts tests/funnel.test.ts tests/cleanup.test.mjs tests/staff-email.test.ts tests/password-reset.test.mjs tests/recovery-email.test.mjs && node supabase/tests/funnel-events.mjs && npm run test:phase1",
    "test:funnel": "tsx --test tests/funnel.test.ts && node supabase/tests/funnel-events.mjs",
    "test:signin": "node --test tests/signin-browser.test.mjs",
    "test:browser": "node --test tests/signin-browser.test.mjs tests/proof-card-browser.test.mjs tests/turnstile-browser.test.mjs",
    "capture:auth": "node scripts/capture-auth-shots.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tesseract.js-data/eng": "^1.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tesseract.js": "^7.0.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@electric-sql/pglite": "^0.5.17",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "playwright-core": "^1.65.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
