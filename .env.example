# Supabase Configuration
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional WebRTC TURN relay for voice calls behind strict campus/mobile NATs
# VITE_TURN_URL="turns:standard.relay.metered.ca:443"
# VITE_TURN_USERNAME=""
# VITE_TURN_CREDENTIAL=""

# Server-only cleanup worker. Set securely per deployment; never use VITE_ prefixes for these.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Public build-time key (leave blank to hide the widget).
VITE_TURNSTILE_SITE_KEY=
# Supabase Edge Function secret; never prefix this with VITE_.
TURNSTILE_SECRET_KEY=
